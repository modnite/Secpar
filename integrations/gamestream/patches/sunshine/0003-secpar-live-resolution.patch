diff --git a/src/secpar_resolution.h b/src/secpar_resolution.h
new file mode 100644
index 0000000..c372fac
--- /dev/null
+++ b/src/secpar_resolution.h
@@ -0,0 +1,109 @@
+/**
+ * @file src/secpar_resolution.h
+ * @brief Secpar: a stream size the connected device asks for while a stream runs.
+ *
+ * Sunshine takes the stream size from the client's RTSP ANNOUNCE alone, so a new
+ * size means a new session: the encoder is built at the client's size, the
+ * capture runs at the display's size, and the encoder's own sequence header and
+ * keyframe tell the client to reconfigure.
+ *
+ * Secpar asks for the same thing on the engine's authenticated management port
+ * while a stream is already running. The capture thread builds its encoder again
+ * at the requested size and keeps capturing the same display, which the existing
+ * encode path scales. The computer's display mode is never changed: the person
+ * sitting at it keeps the resolution they chose.
+ *
+ * Only the encode session is rebuilt. The capture chain (DXGI duplication, KWin,
+ * the portal) is untouched, which is what keeps a renegotiated capture from
+ * stalling a running stream on Linux.
+ */
+#pragma once
+
+#include <mutex>
+#include <optional>
+
+namespace secpar_resolution {
+  /**
+   * @brief A stream size, in pixels.
+   */
+  struct frame_size_t {
+    int width;
+    int height;
+  };
+
+  /// A picture smaller than this is not worth a stream.
+  constexpr int MIN_SIDE = 64;
+  /// Above any display Secpar streams from.
+  constexpr int MAX_SIDE = 7680;
+
+  /**
+   * @brief Whether an encoder can be asked for this size.
+   *
+   * Both sides are even because 4:2:0 chroma needs pairs of pixels.
+   */
+  inline bool valid(int width, int height) {
+    return width >= MIN_SIDE && height >= MIN_SIDE && width <= MAX_SIDE && height <= MAX_SIDE && width % 2 == 0 && height % 2 == 0;
+  }
+
+  namespace state {
+    inline std::mutex &guard() {
+      static std::mutex value;
+      return value;
+    }
+    inline std::optional<frame_size_t> &waiting() {
+      static std::optional<frame_size_t> value;
+      return value;
+    }
+    inline std::optional<frame_size_t> &running() {
+      static std::optional<frame_size_t> value;
+      return value;
+    }
+  }  // namespace state
+
+  /**
+   * @brief Records the size the connected device wants.
+   * @return False for a size no encoder can be built at.
+   */
+  inline bool request(int width, int height) {
+    if (!valid(width, height)) {
+      return false;
+    }
+    std::lock_guard lock {state::guard()};
+    state::waiting() = frame_size_t {width, height};
+    return true;
+  }
+
+  /**
+   * @brief Whether a request is still waiting for the capture thread.
+   */
+  inline bool pending() {
+    std::lock_guard lock {state::guard()};
+    return state::waiting().has_value();
+  }
+
+  /**
+   * @brief Takes the waiting request, leaving none.
+   */
+  inline std::optional<frame_size_t> take() {
+    std::lock_guard lock {state::guard()};
+    auto value = state::waiting();
+    state::waiting().reset();
+    return value;
+  }
+
+  /**
+   * @brief Notes the size the running stream encodes at now.
+   */
+  inline void running(int width, int height) {
+    std::lock_guard lock {state::guard()};
+    state::running() = frame_size_t {width, height};
+  }
+
+  /**
+   * @brief The size the running stream encodes at now, if it was ever changed.
+   */
+  inline std::optional<frame_size_t> running() {
+    std::lock_guard lock {state::guard()};
+    return state::running();
+  }
+}  // namespace secpar_resolution
