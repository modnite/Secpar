+   */
+  void setStreamResolution(const resp_https_t &response, const req_https_t &request) {
+    if (!check_content_type(response, request, "application/json")) {
+      return;
+    }
+    if (!authenticate(response, request)) {
+      return;
+    }
+
+    // The engine listens on this computer only, and Secpar's background part
+    // talks to it over loopback. Anything else is not this feature.
+    const auto remote = net::addr_to_normalized_string(request->remote_endpoint().address());
+    if (remote != "127.0.0.1"sv && remote != "::1"sv) {
+      BOOST_LOG(warning) << "Secpar: refusing a stream size change from "sv << remote;
+      nlohmann::json output_tree;
+      output_tree["status"] = false;
+      output_tree["error"] = "local_only";
+      send_response(response, output_tree);
+      return;
+    }
