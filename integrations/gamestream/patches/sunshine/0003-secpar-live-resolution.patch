+
+    std::stringstream ss;
+    ss << request->content.rdbuf();
+    try {
+      const nlohmann::json input_tree = nlohmann::json::parse(ss);
+      const int width = input_tree.value("width", 0);
+      const int height = input_tree.value("height", 0);
+      // A size change applies to a stream that is already running. Without one
+      // there is nothing to change, and the next stream takes its size from the
+      // client that starts it.
+      const bool streaming = rtsp_stream::session_count() > 0;
+      nlohmann::json output_tree;
+      if (!streaming) {
+        output_tree["status"] = true;
+        output_tree["streaming"] = false;
+        send_response(response, output_tree);
+        return;
+      }
+      if (!secpar_resolution::request(width, height)) {
+        bad_request(response, request, "width and height must be even numbers from 64 to 7680");
+        return;
+      }
+      BOOST_LOG(info) << "Secpar: the connected device asked for "sv << width << 'x' << height;
+      output_tree["status"] = true;
+      output_tree["streaming"] = true;
+      send_response(response, output_tree);
+    } catch (nlohmann::json::exception &e) {
+      BOOST_LOG(warning) << "SetStreamResolution: "sv << e.what();
+      bad_request(response, request, e.what());
+    }
+  }
