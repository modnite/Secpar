+  int creds_stdin(const char *name, int argc, char *argv[]) {
+    // Secpar: the password is read from stdin so it never appears in argv.
+    // One line, 8..256 bytes, no control characters.
+    if (argc < 1 || argv[0] == "help"sv) {
+      help(name);
+      return 1;
+    }
+
+    std::string password;
+    char c;
+    while (std::cin.get(c) && c != '\n') {
+      if (password.size() >= 256) {
+        BOOST_LOG(error) << "Credential input is too long"sv;
+        return 2;
+      }
+      password.push_back(c);
+    }
+    if (!password.empty() && password.back() == '\r') {
+      password.pop_back();
+    }
+    if (password.size() < 8) {
+      BOOST_LOG(error) << "Credential input is too short"sv;
+      return 2;
+    }
+    for (unsigned char ch : password) {
+      if (ch < 0x20 || ch == 0x7f) {
+        BOOST_LOG(error) << "Credential input contains control characters"sv;
+        return 2;
+      }
+    }
+
+    return http::save_user_creds(config::sunshine.credentials_file, argv[0], password) == 0 ? 0 : 3;
+  }
+
   int help(const char *name) {
     logging::print_help(name);
     return 0;
