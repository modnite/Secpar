+QStringList SdlInputHandler::getSecparPlayers()
+{
+    QStringList players;
+
+    for (int i = 0; i < SDL_arraysize(m_GamepadState); i++) {
+        const GamepadState& state = m_GamepadState[i];
+        if (state.controller == nullptr) {
+            continue;
+        }
+
+        const char* name = SDL_GameControllerName(state.controller);
+        if (name == nullptr || name[0] == 0) {
+            name = SDL_JoystickName(SDL_GameControllerGetJoystick(state.controller));
+        }
+
+        players.append(QStringLiteral("Player %1 · %2")
+                       .arg(state.index >= 0 ? state.index + 1 : i + 1)
+                       .arg(QString::fromUtf8(name != nullptr ? name : "Controller")));
+    }
+
+    return players;
+}
