+bool SecparMenu::handleEvent(const SDL_Event* event)
+{
+    if (m_Session == nullptr) {
+        return false;
+    }
+
+    switch (event->type) {
+    case SDL_KEYDOWN:
+        // Ctrl+Alt+S (or the configured chord) opens and closes the menu, and
+        // releases input capture so the pointer can be used on the menu.
+        if (!event->key.repeat && matchesChord(event->key.keysym, m_ChordMenu)) {
+            SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION, "Secpar menu: chord");
+            m_SwallowKey = event->key.keysym.sym;
+            if (m_Open) {
+                close();
+            }
+            else {
+                open();
+            }
+            return true;
+        }
+        // The three chords work whether or not the menu is open, like the
+        // desktop stream menu. None of them ever reaches the host.
+        if (!event->key.repeat && matchesChord(event->key.keysym, m_ChordFullscreen)) {
+            m_SwallowKey = event->key.keysym.sym;
+            toggleFullscreen();
+            return true;
+        }
+        if (!event->key.repeat && matchesChord(event->key.keysym, m_ChordDisconnect)) {
+            m_SwallowKey = event->key.keysym.sym;
+            disconnect();
+            return true;
+        }
+        if (!m_Open) {
+            return false;
+        }
+        switch (event->key.keysym.sym) {
+        case SDLK_ESCAPE:
+            if (!event->key.repeat) {
+                close();
+            }
+            return true;
+        case SDLK_UP:
+            moveHover(-1);
+            return true;
+        case SDLK_DOWN:
+            moveHover(1);
+            return true;
+        case SDLK_LEFT:
+        case SDLK_BACKSPACE:
+            if (!event->key.repeat) {
+                goBack();
+            }
+            return true;
+        case SDLK_RETURN:
+        case SDLK_KP_ENTER:
+            if (!event->key.repeat) {
+                activate(m_Hover);
+            }
+            return true;
+        default:
+            // The open menu owns the keyboard; nothing leaks to the host.
+            return true;
+        }
+
+    case SDL_KEYUP:
+        if (event->key.keysym.sym == m_SwallowKey) {
+            m_SwallowKey = SDLK_UNKNOWN;
+            return true;
+        }
+        return m_Open;
+
+    case SDL_MOUSEMOTION:
+        if (m_Dragging) {
+            const QRect video = videoRect();
+            const qreal maxX = qMax(0, video.width() - kButtonSize - 2 * kButtonMargin);
+            const qreal maxY = qMax(0, video.height() - kButtonSize - 2 * kButtonMargin);
+            const QPointF moved(event->motion.x - m_DragStart.x(), event->motion.y - m_DragStart.y());
+            if (qAbs(moved.x()) > 3 || qAbs(moved.y()) > 3) {
+                m_DragMoved = true;
+            }
+            const QPointF wanted = m_DragButtonStart + moved;
+            setButtonFraction(QPointF(maxX > 0 ? (wanted.x() - video.left() - kButtonMargin) / maxX : 0.0,
+                                      maxY > 0 ? (wanted.y() - video.top() - kButtonMargin) / maxY : 0.0));
+            // The pointer belongs to the menu while it drags, not to the host.
+            return true;
+        }
+        if (m_Open) {
+            updateHover(event->motion.x, event->motion.y);
+            return true;
+        }
+        updateButtonHover(event->motion.x, event->motion.y);
+        return false;
+
+    case SDL_MOUSEBUTTONDOWN:
+        if (event->button.button != SDL_BUTTON_LEFT) {
+            return m_Open;
+        }
+        // Pressing the button starts a drag and letting go without moving
+        // toggles the menu. Both need a released pointer, so they work whether
+        // or not the menu is already open, and in fullscreen after the chord.
+        if (m_Session->m_InputHandler != nullptr &&
+            !m_Session->m_InputHandler->isCaptureActive() &&
+            m_ButtonRect.contains(QPoint(event->button.x, event->button.y))) {
+            m_Dragging = true;
+            m_DragMoved = false;
+            m_DragStart = QPointF(event->button.x, event->button.y);
+            m_DragButtonStart = m_ButtonRect.topLeft();
+            return true;
+        }
+        if (m_Open) {
+            const QPoint point(event->button.x, event->button.y);
+            const int row = rowAt(point);
+            if (row >= 0) {
+                activate(row);
+            }
+            else if (!m_PanelRect.contains(point)) {
+                close();
+            }
+            return true;
+        }
+        return false;
+
+    case SDL_MOUSEBUTTONUP:
+        if (m_Dragging) {
+            m_Dragging = false;
+            if (m_DragMoved) {
+                saveButtonPosition();
+            }
+            else if (m_Open) {
+                close();
+            }
+            else {
+                open();
+            }
+            return true;
+        }
+        return m_Open;
+
+    case SDL_MOUSEWHEEL:
+        return m_Open;
+
+    default:
+        return false;
+    }
+}
+
+void SecparMenu::open()
+{
+    if (m_Open) {
+        return;
+    }
+
+    m_Open = true;
+    m_Page = PageMain;
+    m_Hover = -1;
+    m_HoverButton = false;
+    m_Dirty = true;
+    SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION, "Secpar menu: opened");
+
+    if (m_Session->m_InputHandler != nullptr) {
+        m_RestoreCapture = m_Session->m_InputHandler->isCaptureActive();
+        m_Session->m_InputHandler->setCaptureActive(false);
+        m_Session->m_InputHandler->raiseAllKeys();
+    }
+    SDL_ShowCursor(SDL_ENABLE);
+}
+
+void SecparMenu::close()
+{
+    if (!m_Open) {
+        return;
+    }
+
+    m_Open = false;
+    m_Page = PageMain;
+    m_Hover = -1;
+    m_Dirty = true;
+    SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION, "Secpar menu: closed");
+
+    if (m_RestoreCapture && m_Session->m_InputHandler != nullptr) {
+        m_Session->m_InputHandler->setCaptureActive(true);
+        m_Session->m_InputHandler->raiseAllKeys();
+    }
+    m_RestoreCapture = false;
+}
+
+void SecparMenu::setPage(int page)
+{
+    SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION, "Secpar menu: page %d", page);
+    m_Page = page;
+    m_Hover = -1;
+    m_Dirty = true;
+
+    if (page == PageQuality && m_Quality != QualityChanging) {
+        // The app may have been started or connected since the last look.
+        checkApp();
+    }
+}
+
+void SecparMenu::goBack()
+{
+    if (m_Page != PageMain) {
+        setPage(PageMain);
+    }
+    else {
+        close();
+    }
+}
+
+void SecparMenu::moveHover(int delta)
+{
+    if (m_RowActions.isEmpty()) {
+        return;
+    }
+
+    int index = m_Hover;
+    for (int step = 0; step < m_RowActions.size(); step++) {
+        index += delta;
+        if (index < 0) {
+            index = m_RowActions.size() - 1;
+        }
+        else if (index >= m_RowActions.size()) {
+            index = 0;
+        }
+        if (m_RowActions.at(index) != ActionNone && index < m_RowInteractive.size() &&
+            m_RowInteractive.at(index)) {
+            m_Hover = index;
+            m_Dirty = true;
+            return;
+        }
+    }
+}
+
+void SecparMenu::activate(int index)
+{
+    if (index < 0 || index >= m_RowActions.size()) {
+        return;
+    }
+    SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION, "Secpar menu: activate row %d action %d",
+                index, m_RowActions.at(index));
+
+    switch (m_RowActions.at(index)) {
+    case ActionToggleFullscreen:
+        toggleFullscreen();
+        break;
+    case ActionQuality:
+        setPage(PageQuality);
+        break;
+    case ActionPlayers:
+        setPage(PagePlayers);
+        break;
+    case ActionBack:
+        goBack();
+        break;
+    case ActionToggleStats:
+        toggleStats();
+        break;
+    case ActionDisconnect:
+        disconnect();
+        break;
+    case ActionResetButton:
+        resetButtonPosition();
+        break;
+    case ActionResolution:
+        if (index < m_RowSizes.size()) {
+            const QSize size = m_RowSizes.at(index);
+            if (!size.isEmpty() && size != streamSize()) {
+                askResolution(size.width(), size.height());
+            }
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+void SecparMenu::toggleFullscreen()
+{
+    close();
+    m_Session->toggleFullscreen();
+    SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION, "Secpar menu: fullscreen toggle, window flags now 0x%x",
+                (unsigned)SDL_GetWindowFlags(m_Window));
+    if (m_Session->m_InputHandler != nullptr) {
+        m_Session->m_InputHandler->raiseAllKeys();
+    }
+    m_Dirty = true;
+}
+
+void SecparMenu::toggleStats()
+{
+    Overlay::OverlayManager& overlays = m_Session->getOverlayManager();
+    const bool enabled = overlays.isOverlayEnabled(Overlay::OverlayDebug);
+    overlays.setOverlayState(Overlay::OverlayDebug, !enabled);
+    m_Dirty = true;
+}
+
+void SecparMenu::disconnect()
+{
+    close();
+
+    // Same path as Moonlight's own quit combo: the stream ends and the window
+    // returns to the Secpar app.
+    SDL_Event event;
+    SDL_zero(event);
+    event.type = SDL_QUIT;
+    event.quit.timestamp = SDL_GetTicks();
+    SDL_PushEvent(&event);
+}
+
+void SecparMenu::updateButtonHover(int x, int y)
+{
+    const bool hover = m_Session->m_InputHandler != nullptr &&
+            !m_Session->m_InputHandler->isCaptureActive() &&
+            m_ButtonRect.contains(QPoint(x, y));
+    if (hover != m_HoverButton) {
+        m_HoverButton = hover;
+        m_Dirty = true;
+    }
+}
+
+QSize SecparMenu::streamSize() const
+{
+    if (m_Session->m_VideoDecoder != nullptr) {
+        const QSize decoded = m_Session->m_VideoDecoder->getLastVideoSize();
+        if (decoded.width() > 0 && decoded.height() > 0) {
+            return decoded;
+        }
+    }
+
+    return QSize(m_Session->m_ActiveVideoWidth, m_Session->m_ActiveVideoHeight);
+}
+
+void SecparMenu::checkApp()
+{
+    m_Quality = QualityChecking;
+    m_QualityNote = QStringLiteral("Checking the Secpar app…");
+    m_Dirty = true;
+    startCall(QByteArrayLiteral("{\"do\":\"status\"}\n"));
+}
+
+void SecparMenu::askResolution(int width, int height)
+{
+    SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION, "Secpar menu: asking for %dx%d", width, height);
+    m_Wanted = QSize(width, height);
+    m_WantedAt = SDL_GetTicks();
+    m_Quality = QualityChanging;
+    m_QualityNote = QStringLiteral("Changing to %1 × %2…").arg(width).arg(height);
+    m_Dirty = true;
+    startCall(QStringLiteral("{\"do\":\"resolution\",\"width\":%1,\"height\":%2}\n")
+              .arg(width).arg(height).toUtf8());
+}
+
+void SecparMenu::startCall(const QByteArray& line)
+{
+    auto call = std::make_shared<ChannelCall>();
+    m_Call = call;
+    m_CallHandled = false;
+    std::thread(runChannelCall, serviceChannel(), line, call).detach();
+}
+
+void SecparMenu::pollChannel()
+{
+    if (m_CallHandled || !m_Call || !m_Call->done.load(std::memory_order_acquire)) {
+        return;
+    }
+
+    m_CallHandled = true;
+    const ChannelCall& call = *m_Call;
+    const bool probe = m_Quality == QualityChecking;
+    SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION,
+                "Secpar menu: channel answered=%d ok=%d streaming=%d connected=%d error=%s",
+                call.answered, call.ok, call.streaming, call.connected,
+                call.error.toUtf8().constData());
+
+    if (!call.answered) {
+        // The channel is not there, or nothing answered: the component is
+        // running on its own, outside Secpar.
+        m_Quality = probe ? QualityNoChannel : QualityRefused;
+        m_QualityNote = probe ? QStringLiteral("Change the size in the Secpar app")
+                              : QStringLiteral("The Secpar app did not answer");
+    }
+    else if (probe) {
+        if (call.ok && call.connected) {
+            m_Quality = QualityReady;
+            m_QualityNote.clear();
+        }
+        else if (call.ok) {
+            m_Quality = QualityNotConnected;
+            m_QualityNote = QStringLiteral("Not connected through the Secpar app");
+        }
+        else {
+            m_Quality = QualityNoChannel;
+            m_QualityNote = QStringLiteral("Change the size in the Secpar app");
+        }
+    }
+    else if (call.ok) {
+        // The encoder is being rebuilt. QualityChanging stays until the
+        // picture reports the new size.
+        if (!call.streaming) {
+            m_Quality = QualityRefused;
+            m_QualityNote = QStringLiteral("No stream is running to resize");
+        }
+    }
+    else if (call.error == QLatin1String("not_connected")) {
+        m_Quality = QualityNotConnected;
+        m_QualityNote = QStringLiteral("Not connected through the Secpar app");
+    }
+    else if (call.error == QLatin1String("not_allowed")) {
+        m_Quality = QualityRefused;
+        m_QualityNote = QStringLiteral("Only this computer's owner can change the size");
+    }
+    else {
+        m_Quality = QualityRefused;
+        m_QualityNote = QStringLiteral("The app refused the change");
+    }
+
+    m_Dirty = true;
+}
+
+void SecparMenu::settlePendingSize()
+{
+    if (m_Quality != QualityChanging) {
+        return;
+    }
+
+    const QSize size = streamSize();
+    if (size == m_Wanted) {
+        m_Quality = QualityReady;
+        m_QualityNote.clear();
+        m_Dirty = true;
+    }
+    else if (SDL_GetTicks() - m_WantedAt > 8000) {
+        m_Quality = QualityRefused;
+        m_QualityNote = QStringLiteral("The stream reports %1 × %2").arg(size.width()).arg(size.height());
+        m_Dirty = true;
+    }
+}
+
+QVector<SecparMenu::Row> SecparMenu::buildRows() const
+{
+    QVector<Row> rows;
+
+    const bool fullScreen = m_Window != nullptr &&
+            (SDL_GetWindowFlags(m_Window) & m_Session->m_FullScreenFlag) != 0;
+
+    const QSize current = streamSize();
+    const int fps = m_Session->m_ActiveVideoFrameRate > 0 ?
+                m_Session->m_ActiveVideoFrameRate : m_Session->m_StreamConfig.fps;
+
+    QStringList players;
+    if (m_Session->m_InputHandler != nullptr) {
+        players = m_Session->m_InputHandler->getSecparPlayers();
+    }
+
+    const QString resolution = QStringLiteral("%1 × %2").arg(current.width()).arg(current.height());
+
+    if (m_Page == PageQuality) {
+        QString decoder;
+        if (m_Session->m_VideoDecoder != nullptr) {
+            decoder = m_Session->m_VideoDecoder->isHardwareAccelerated() ?
+                        QStringLiteral("Hardware") : QStringLiteral("Software");
+        }
+
+        rows.append({kSvgArrowLeft, QStringLiteral("Quality"), QString(), QSize(),
+                     ActionBack, false, false, false, true});
+        rows.append({nullptr, QString(), QString(), QSize(), ActionNone, false, false, false, false});
+
+        if (!m_QualityNote.isEmpty()) {
+            rows.append({nullptr, m_QualityNote, QString(), QSize(),
+                         ActionNone, false, false, m_Quality == QualityRefused, false});
+        }
+
+        // The size the stream runs at first, then the sizes this component
+        // offers. Picking one asks the connected computer for it.
+        QVector<QSize> sizes;
+        if (!current.isEmpty()) {
+            sizes.append(current);
+        }
+        const QSize offered[] = { QSize(1280, 720), QSize(1920, 1080),
+                                  QSize(2560, 1440), QSize(3840, 2160) };
+        for (const QSize& size : offered) {
+            if (!sizes.contains(size)) {
+                sizes.append(size);
+            }
+        }
+
+        const bool ready = m_Quality == QualityReady;
+        for (const QSize& size : sizes) {
+            rows.append({nullptr,
+                         QStringLiteral("%1 × %2").arg(size.width()).arg(size.height()),
+                         QString(), size, ActionResolution,
+                         false, size == current, false, ready});
+        }
+
+        rows.append({nullptr, QString(), QString(), QSize(), ActionNone, false, false, false, false});
+        rows.append({nullptr, QStringLiteral("%1 fps · %2 Mbps")
+                     .arg(fps).arg(m_Session->m_StreamConfig.bitrate / 1000.0, 0, 'f', 1),
+                     QString(), QSize(), ActionNone, false, false, false, false});
+        rows.append({nullptr, QStringLiteral("%1 · %2").arg(codecName(m_Session->m_ActiveVideoFormat), decoder),
+                     QString(), QSize(), ActionNone, false, false, false, false});
+        return rows;
+    }
+
+    if (m_Page == PagePlayers) {
+        rows.append({kSvgArrowLeft, QStringLiteral("Players and stats"), QString(), QSize(),
+                     ActionBack, false, false, false, true});
+        rows.append({nullptr, QString(), QString(), QSize(), ActionNone, false, false, false, false});
+        rows.append({kSvgStats, QStringLiteral("Stats overlay"), QString(), QSize(),
+                     ActionToggleStats, false,
+                     m_Session->getOverlayManager().isOverlayEnabled(Overlay::OverlayDebug),
+                     false, true});
+        if (players.isEmpty()) {
+            rows.append({nullptr, QStringLiteral("No controllers connected"), QString(), QSize(),
+                         ActionNone, false, false, false, false});
+        }
+        else {
+            for (const QString& player : players) {
+                rows.append({kSvgGamepad, player, QString(), QSize(),
+                             ActionNone, false, false, false, false});
+            }
+        }
+        return rows;
+    }
+
+    QString playersValue;
+    if (players.isEmpty()) {
+        playersValue = QStringLiteral("None");
+    }
+    else {
+        playersValue = players.size() == 1 ? QStringLiteral("1 controller") :
+                                             QStringLiteral("%1 controllers").arg(players.size());
+    }
+
+    rows.append({fullScreen ? kSvgMinimize : kSvgMaximize,
+                 fullScreen ? QStringLiteral("Window") : QStringLiteral("Fullscreen"),
+                 m_ChordFullscreen.text, QSize(),
+                 ActionToggleFullscreen, false, false, false, true});
+    rows.append({kSvgCpu, QStringLiteral("Quality"), resolution, QSize(),
+                 ActionQuality, true, false, false, true});
+    rows.append({kSvgGamepad, QStringLiteral("Players and stats"), playersValue, QSize(),
+                 ActionPlayers, true, false, false, true});
+    rows.append({kSvgRefresh, QStringLiteral("Reset position"), QString(), QSize(),
+                 ActionResetButton, false, false, false, true});
+    rows.append({nullptr, QString(), QString(), QSize(), ActionNone, false, false, false, false});
+    rows.append({kSvgLogOut, QStringLiteral("Disconnect"), m_ChordDisconnect.text, QSize(),
+                 ActionDisconnect, false, false, true, true});
+
+    return rows;
+}
+
+void SecparMenu::render()
+{
+    if (m_Session == nullptr || m_Window == nullptr) {
+        return;
+    }
+
+    const QVector<Row> rows = buildRows();
+
+    // Rows are laid out inside the panel, then moved to where the panel goes.
+    const int innerLeft = kPanelMargin;
+    const int innerWidth = kPanelWidth - 2 * kPanelMargin;
+    int y = kPanelMargin;
+    m_RowRects.clear();
+    m_RowActions.clear();
+    m_RowInteractive.clear();
+    m_RowSizes.clear();
+    for (const Row& row : rows) {
+        const bool divider = row.label.isEmpty() && row.icon == nullptr;
+        const int rowHeight = divider ? kDividerHeight : kRowHeight;
+        m_RowRects.append(QRectF(innerLeft, y, innerWidth, rowHeight));
+        m_RowActions.append(row.action);
+        m_RowInteractive.append(row.interactive);
+        m_RowSizes.append(row.size);
+        y += rowHeight;
+    }
+
+    const int panelHeight = y + kPanelMargin + kFooterHeight;
+    m_PanelSize = QSizeF(kPanelWidth, panelHeight);
+
+    // The button lives inside the picture, not the window: on a 4:3 stream in
+    // a 16:9 window the picture has bars beside it and the button must not.
+    const QRect video = videoRect();
+    const qreal maxX = qMax(0, video.width() - kButtonSize - 2 * kButtonMargin);
+    const qreal maxY = qMax(0, video.height() - kButtonSize - 2 * kButtonMargin);
+    m_ButtonRect = QRectF(video.left() + kButtonMargin + m_ButtonFrac.x() * maxX,
+                          video.top() + kButtonMargin + m_ButtonFrac.y() * maxY,
+                          kButtonSize, kButtonSize);
+
+    const QRectF panel = panelFor(video, m_ButtonRect, m_PanelSize);
+    m_PanelRect = panel;
+    for (int i = 0; i < m_RowRects.size(); i++) {
+        m_RowRects[i].translate(panel.left(), panel.top());
+    }
+
+    const QRectF bounds = m_Open ? m_ButtonRect.united(panel) : m_ButtonRect;
+    const int pixelWidth = qMax(1, qCeil(bounds.width() * m_Scale));
+    const int pixelHeight = qMax(1, qCeil(bounds.height() * m_Scale));
+
+    QImage image(pixelWidth, pixelHeight, QImage::Format_ARGB32_Premultiplied);
+    image.fill(Qt::transparent);
+
+    {
+        QPainter painter(&image);
+        painter.setRenderHint(QPainter::Antialiasing, true);
+        painter.setRenderHint(QPainter::TextAntialiasing, true);
+        painter.scale(m_Scale, m_Scale);
+        painter.translate(-bounds.left(), -bounds.top());
+
+        if (m_Open) {
+            painter.setPen(Qt::NoPen);
+            painter.setBrush(kPanel);
+            painter.drawRoundedRect(m_PanelRect, kPanelRadius, kPanelRadius);
+
+            for (int i = 0; i < rows.size(); i++) {
+                const bool hovered = rows.at(i).interactive && i == m_Hover;
+                drawRow(painter, rows.at(i), m_RowRects.at(i), hovered);
+            }
+
+            painter.setFont(uiFont(10));
+            painter.setPen(kMuted);
+            const QRectF footer(m_PanelRect.left() + kPanelMargin + 3,
+                                m_PanelRect.bottom() - kFooterHeight,
+                                innerWidth - 6, kFooterHeight - kPanelMargin);
+            painter.drawText(footer, Qt::AlignLeft | Qt::AlignVCenter,
+                             QStringLiteral("Secpar"));
+            painter.drawText(footer, Qt::AlignRight | Qt::AlignVCenter, m_ChordMenu.text);
+        }
+
+        // The floating button stays on screen in windowed and fullscreen mode.
+        painter.setPen(Qt::NoPen);
+        painter.setBrush(m_HoverButton || m_Open ? kPanel : kButton);
+        painter.drawRoundedRect(m_ButtonRect, kButtonRadius, kButtonRadius);
+        paintTriangle(painter, m_ButtonRect.adjusted(8, 8, -8, -8));
+    }
+
+    const QImage straight = image.convertToFormat(QImage::Format_ARGB32);
+    SDL_Surface* surface = SDL_CreateRGBSurfaceWithFormat(0, straight.width(), straight.height(),
+                                                         32, SDL_PIXELFORMAT_ARGB8888);
+    if (surface == nullptr) {
+        SDL_LogError(SDL_LOG_CATEGORY_APPLICATION,
+                     "SDL_CreateRGBSurfaceWithFormat() failed for the stream menu: %s",
+                     SDL_GetError());
+        return;
+    }
+
+    SDL_LockSurface(surface);
+    for (int row = 0; row < straight.height(); row++) {
+        std::memcpy(static_cast<Uint8*>(surface->pixels) + row * surface->pitch,
+                    straight.constScanLine(row),
+                    static_cast<size_t>(straight.width()) * 4);
+    }
+    SDL_UnlockSurface(surface);
+
+    const SDL_Rect windowRect = { qRound(bounds.left() * m_Scale), qRound(bounds.top() * m_Scale),
+                                  pixelWidth, pixelHeight };
+    pushSurface(surface, windowRect);
+}
+
+QRect SecparMenu::videoRect() const
+{
+    if (m_Window == nullptr) {
+        return QRect();
+    }
+
+    int width = 0;
+    int height = 0;
+    SDL_GetWindowSize(m_Window, &width, &height);
+    if (width <= 0 || height <= 0) {
+        return QRect();
+    }
+
+    const QSize picture = streamSize();
+    if (picture.width() <= 0 || picture.height() <= 0) {
+        return QRect(0, 0, width, height);
+    }
+
+    SDL_Rect src = { 0, 0, picture.width(), picture.height() };
+    SDL_Rect dst = { 0, 0, width, height };
+    StreamUtils::scaleSourceToDestinationSurface(&src, &dst);
+    return QRect(dst.x, dst.y, dst.w, dst.h);
+}
+
+QRectF SecparMenu::panelFor(const QRect& video, const QRectF& button, const QSizeF& panelSize) const
+{
+    qreal x = button.right() + kPanelGap;
+    if (x + panelSize.width() > video.right()) {
+        // Open to the left of the button when there is no room on the right.
+        x = button.left() - kPanelGap - panelSize.width();
+    }
+    const qreal maxX = qMax<qreal>(video.left(), video.right() - panelSize.width());
+    x = qBound<qreal>(video.left(), x, maxX);
+
+    const qreal maxY = qMax<qreal>(video.top(), video.bottom() - panelSize.height());
+    const qreal y = qBound<qreal>(video.top(), button.top(), maxY);
+    return QRectF(x, y, panelSize.width(), panelSize.height());
+}
+
+void SecparMenu::setButtonFraction(const QPointF& fraction)
+{
+    m_ButtonFrac = QPointF(qBound<qreal>(0, fraction.x(), 1),
+                           qBound<qreal>(0, fraction.y(), 1));
+    m_Dirty = true;
+}
+
+void SecparMenu::saveButtonPosition() const
+{
+    QSettings settings;
+    settings.setValue(QStringLiteral("secpar/buttonX"), m_ButtonFrac.x());
+    settings.setValue(QStringLiteral("secpar/buttonY"), m_ButtonFrac.y());
+}
+
+void SecparMenu::resetButtonPosition()
+{
+    setButtonFraction(QPointF(0, 0));
+    saveButtonPosition();
+}
+
+
+void SecparMenu::drawRow(QPainter& painter, const Row& row, const QRectF& rect, bool hovered) const
+{
+    if (row.label.isEmpty() && row.icon == nullptr) {
+        painter.setPen(Qt::NoPen);
+        painter.setBrush(kLine);
+        painter.drawRect(QRectF(rect.left(), rect.center().y(), rect.width(), 1));
+        return;
+    }
+
+    if (hovered) {
+        painter.setPen(Qt::NoPen);
+        painter.setBrush(kHover);
+        painter.drawRoundedRect(rect, 3, 3);
+    }
+
+    const bool infoRow = row.action == ActionNone;
+    const QColor labelColor = infoRow ? (row.danger ? kDanger : kMuted)
+                                      : (row.danger ? kDanger : kText);
+
+    if (row.icon != nullptr) {
+        paintIcon(painter, row.icon,
+                  QRectF(rect.left() + kIconLeft, rect.top() + (rect.height() - kIconSize) / 2.0,
+                         kIconSize, kIconSize),
+                  labelColor);
+    }
+
+    const int trailing = (row.chevron || row.check) ? 24 : 0;
+    const int labelWidth = qMax(0, int(rect.width()) - kLabelLeft - trailing -
+                                (row.value.isEmpty() ? 0 : 12));
+
+    painter.setFont(uiFont(infoRow ? 13 : 14));
+    painter.setPen(labelColor);
+    const QFontMetrics labelMetrics(painter.font());
+    painter.drawText(QRectF(rect.left() + kLabelLeft, rect.top(), labelWidth, rect.height()),
+                     Qt::AlignLeft | Qt::AlignVCenter,
+                     labelMetrics.elidedText(row.label, Qt::ElideRight, labelWidth));
+
+    if (!row.value.isEmpty()) {
+        painter.setFont(uiFont(infoRow ? 13 : 12));
+        painter.setPen(infoRow ? kText : kMuted);
+        const int valueWidth = qMax(0, int(rect.width()) - kLabelLeft - trailing - 12);
+        const QFontMetrics valueMetrics(painter.font());
+        painter.drawText(QRectF(rect.left() + kLabelLeft, rect.top(), valueWidth, rect.height()),
+                         Qt::AlignRight | Qt::AlignVCenter,
+                         valueMetrics.elidedText(row.value, Qt::ElideRight, valueWidth));
+    }
+
+    if (row.chevron || row.check) {
+        paintIcon(painter, row.check ? kSvgCheck : kSvgChevron,
+                  QRectF(rect.right() - 6 - 18, rect.top() + (rect.height() - 18) / 2.0, 18, 18),
+                  row.check ? kAccent : kMuted);
+    }
+}
