+        // Drop the overlay texture with the stream, not with the next session.
+        const SDL_Rect none = { 0, 0, 0, 0 };
+        m_Session->getOverlayManager().setOverlayImage(Overlay::OverlaySecparMenu, nullptr, none);
+    }
+}
