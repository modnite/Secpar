+QRectF SecparMenu::panelRect() const
+{
+    return m_PanelRect;
+}
+
+void SecparMenu::updateHover(int x, int y)
+{
+    const int row = rowAt(QPoint(x, y));
+    if (row != m_Hover) {
+        m_Hover = row;
+        m_Dirty = true;
+    }
+}
