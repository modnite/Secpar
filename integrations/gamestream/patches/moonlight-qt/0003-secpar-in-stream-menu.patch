+// Secpar's in-stream menu: a compact floating button and panel over the video,
+// plus the local key chords that release input capture. The panel is drawn into
+// the renderer's overlay channel, so it also appears over a fullscreen stream.
+//
+// Layout, colours and rows follow the desktop stream menu of Secpar 3. Glyphs
+// are Lucide 0.468.0 artwork (ISC); the button uses the approved Secpar
+// triangle. Chords are read from SecparStream.conf (secpar/chordMenu,
+// secpar/chordFullscreen, secpar/chordDisconnect) and can be overridden with
+// SECPAR_CHORD_MENU, SECPAR_CHORD_FULLSCREEN and SECPAR_CHORD_DISCONNECT.
+//
+// A size change goes to the local background part on its channel, the same one
+// the Secpar window uses: the named pipe "secpar-service" on Windows and
+// $XDG_RUNTIME_DIR/secpar-service.sock on Linux. SECPAR_SERVICE_CHANNEL
+// overrides the name for development.
+class SecparMenu
+{
+public:
+    explicit SecparMenu(Session* session);
+    ~SecparMenu();
