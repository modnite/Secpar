+    // One line sent to the local background part. Public only so the worker
+    // function that fills it in can name the type; it is otherwise internal.
+    struct ChannelCall;
+
+private:
+    enum Page {
+        PageMain,
+        PageQuality,
+        PagePlayers,
+    };
+
+    enum Action {
+        ActionNone,
+        ActionToggleFullscreen,
+        ActionQuality,
+        ActionPlayers,
+        ActionBack,
+        ActionToggleStats,
+        ActionDisconnect,
+        ActionResolution,
+        ActionResetButton,
+    };
+
+    // What the Quality page knows about the local background part.
+    enum Quality {
+        QualityUnknown,
+        QualityChecking,
+        QualityReady,
+        QualityNoChannel,
+        QualityNotConnected,
+        QualityChanging,
+        QualityRefused,
+    };
+
+    struct Row {
+        const char* icon;
+        QString label;
+        QString value;
+        QSize size;
+        int action;
+        bool chevron;
+        bool check;
+        bool danger;
+        bool interactive;
+    };
+
+    struct Chord {
+        SDL_Keycode key;
+        Uint16 mods;
+        QString text;
+        bool isValid() const { return key != SDLK_UNKNOWN; }
+    };
+
+    QVector<Row> buildRows() const;
+
+    void render();
+    void drawRow(QPainter& painter, const Row& row, const QRectF& rect, bool hovered) const;
+    void refreshGeometry();
+    void pushSurface(SDL_Surface* surface, const SDL_Rect& windowRect);
+
+    // Where the picture is on screen, and where the button sits inside it.
+    QRect videoRect() const;
+    QRectF panelFor(const QRect& video, const QRectF& button, const QSizeF& panelSize) const;
+    void setButtonFraction(const QPointF& fraction);
+    void saveButtonPosition() const;
+    void resetButtonPosition();
+
+    bool matchesChord(const SDL_Keysym& keysym, const Chord& chord) const;
+    void open();
+    void close();
+    void setPage(int page);
+    void goBack();
+    void moveHover(int delta);
+    void updateButtonHover(int x, int y);
+    void toggleFullscreen();
+    void toggleStats();
+    void disconnect();
+    void activate(int row);
+    void updateHover(int x, int y);
+    int rowAt(const QPoint& point) const;
+    QRectF panelRect() const;
+
+    // The local background part and the running stream's real size.
+    QSize streamSize() const;
+    void checkApp();
+    void askResolution(int width, int height);
+    void startCall(const QByteArray& line);
+    void pollChannel();
+    void settlePendingSize();
+
+    Session* m_Session;
+    SDL_Window* m_Window;
+    bool m_Open;
+    int m_Page;
+    int m_Hover;
+    bool m_HoverButton;
+    bool m_Dirty;
+    bool m_RestoreCapture;
+    SDL_Keycode m_SwallowKey;
+    Uint32 m_LastRendered;
+    double m_Scale;
+    int m_WindowWidth;
+    int m_WindowHeight;
+
+    Chord m_ChordMenu;
+    Chord m_ChordFullscreen;
+    Chord m_ChordDisconnect;
+
+    Quality m_Quality;
+    QString m_QualityNote;
+    QSize m_Wanted;
+    Uint32 m_WantedAt;
+    std::shared_ptr<ChannelCall> m_Call;
+    bool m_CallHandled;
+
+    QRectF m_ButtonRect;
+    QRectF m_PanelRect;
+    QSizeF m_PanelSize;
+    QPointF m_ButtonFrac;
+    QPointF m_DragStart;
+    QPointF m_DragButtonStart;
+    bool m_Dragging;
+    bool m_DragMoved;
+    QVector<QRectF> m_RowRects;
+    QVector<int> m_RowActions;
+    QVector<bool> m_RowInteractive;
+    QVector<QSize> m_RowSizes;
+};
