+Uint16 chordMods(Uint16 mod)
+{
+    Uint16 bits = 0;
+    if (mod & KMOD_CTRL) {
+        bits |= KMOD_CTRL;
+    }
+    if (mod & KMOD_ALT) {
+        bits |= KMOD_ALT;
+    }
+    if (mod & KMOD_SHIFT) {
+        bits |= KMOD_SHIFT;
+    }
+    return bits;
+}
+
+QString chordLabel(SDL_Keycode key)
+{
+    char buffer[32];
+    const char* name = SDL_GetKeyName(key);
+    if (name == nullptr || name[0] == 0) {
+        return QString();
+    }
+    SDL_strlcpy(buffer, name, sizeof(buffer));
+    return QString::fromLatin1(buffer);
+}
+
+// Accepts "Ctrl+Alt+S", "Ctrl+Shift+F5" and similar, and refuses anything that
+// is not usable as a one-hand chord: function keys, the Windows key and chords
+// without a modifier.
+SDL_Keycode parseChordKey(const QString& name)
+{
+    static const QRegularExpression functionKey(QStringLiteral("^F\\d{1,2}$"),
+                                                QRegularExpression::CaseInsensitiveOption);
+    if (functionKey.match(name).hasMatch()) {
+        return SDLK_UNKNOWN;
+    }
+    const QByteArray utf8 = name.toUtf8();
+    return SDL_GetKeyFromName(utf8.constData());
+}
+
+struct ParsedChord {
+    SDL_Keycode key = SDLK_UNKNOWN;
+    Uint16 mods = 0;
+    QString text;
+};
+
+ParsedChord parseChord(const QString& spec)
+{
+    ParsedChord chord;
+
+    const QStringList parts = spec.split(QLatin1Char('+'), Qt::SkipEmptyParts);
+    if (parts.size() < 2) {
+        return chord;
+    }
+
+    for (int i = 0; i < parts.size() - 1; i++) {
+        const QString part = parts.at(i).trimmed().toUpper();
+        if (part == QLatin1String("CTRL") || part == QLatin1String("CONTROL")) {
+            chord.mods |= KMOD_CTRL;
+        }
+        else if (part == QLatin1String("ALT")) {
+            chord.mods |= KMOD_ALT;
+        }
+        else if (part == QLatin1String("SHIFT")) {
+            chord.mods |= KMOD_SHIFT;
+        }
+        else {
+            // No Windows/Super/Meta: the desktop owns those combinations.
+            return chord;
+        }
+    }
+
+    chord.key = parseChordKey(parts.last().trimmed());
+    if (chord.key == SDLK_UNKNOWN) {
+        return chord;
+    }
+
+    QStringList labels;
+    if (chord.mods & KMOD_CTRL) {
+        labels.append(QStringLiteral("Ctrl"));
+    }
+    if (chord.mods & KMOD_ALT) {
+        labels.append(QStringLiteral("Alt"));
+    }
+    if (chord.mods & KMOD_SHIFT) {
+        labels.append(QStringLiteral("Shift"));
+    }
+    labels.append(chordLabel(chord.key));
+    chord.text = labels.join(QLatin1Char('+'));
+
+    return chord;
+}
+
+ParsedChord readChord(const char* settingsKey, const char* environment, const char* fallback)
+{
+    QString spec = qEnvironmentVariable(environment);
+    if (spec.isEmpty()) {
+        spec = QSettings().value(QString::fromLatin1(settingsKey)).toString();
+    }
+    if (spec.isEmpty()) {
+        spec = QString::fromLatin1(fallback);
+    }
+
+    ParsedChord chord = parseChord(spec);
+    if (chord.key == SDLK_UNKNOWN) {
+        SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION,
+                    "Unusable Secpar stream chord \"%s\" for %s; using %s",
+                    spec.toUtf8().constData(), settingsKey, fallback);
+        chord = parseChord(QString::fromLatin1(fallback));
+    }
+
+    return chord;
+}
