+    m_Page(PageMain),
+    m_Hover(-1),
+    m_HoverButton(false),
+    m_Dirty(true),
+    m_RestoreCapture(false),
+    m_SwallowKey(SDLK_UNKNOWN),
+    m_LastRendered(0),
+    m_Scale(1.0),
+    m_WindowWidth(0),
+    m_WindowHeight(0),
+    m_Quality(QualityUnknown),
+    m_WantedAt(0),
+    m_CallHandled(true)
+{
+    m_Dragging = false;
+    m_DragMoved = false;
+
+    // The button stays where it was left for the rest of the session and comes
+    // back there next time. It is a fraction of the picture, so it survives
+    // resizes and fullscreen.
+    const QSettings settings;
+    setButtonFraction(QPointF(settings.value(QStringLiteral("secpar/buttonX"), 0.0).toDouble(),
+                              settings.value(QStringLiteral("secpar/buttonY"), 0.0).toDouble()));
+
+    const ParsedChord menu = readChord("secpar/chordMenu", "SECPAR_CHORD_MENU", "Ctrl+Alt+S");
+    const ParsedChord fullscreen = readChord("secpar/chordFullscreen", "SECPAR_CHORD_FULLSCREEN", "Ctrl+Alt+W");
+    const ParsedChord disconnect = readChord("secpar/chordDisconnect", "SECPAR_CHORD_DISCONNECT", "Ctrl+Alt+Q");
+
+    m_ChordMenu.key = menu.key;
+    m_ChordMenu.mods = menu.mods;
+    m_ChordMenu.text = menu.text;
+    m_ChordFullscreen.key = fullscreen.key;
+    m_ChordFullscreen.mods = fullscreen.mods;
+    m_ChordFullscreen.text = fullscreen.text;
+    m_ChordDisconnect.key = disconnect.key;
+    m_ChordDisconnect.mods = disconnect.mods;
+    m_ChordDisconnect.text = disconnect.text;
+}
