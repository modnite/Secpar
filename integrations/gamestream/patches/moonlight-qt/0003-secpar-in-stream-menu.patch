+// The local channel the Secpar window also uses. A development override keeps
+// a test build away from the installed background part.
+QString serviceChannel()
+{
+    const QString override = qEnvironmentVariable("SECPAR_SERVICE_CHANNEL");
+    if (!override.isEmpty()) {
+        return override;
+    }
+#ifdef Q_OS_WIN
+    return QStringLiteral("secpar-service");
+#else
+    const QString runtime = qEnvironmentVariable("XDG_RUNTIME_DIR");
+    if (runtime.isEmpty()) {
+        return QStringLiteral("/tmp/secpar-service.sock");
+    }
+    return runtime + QStringLiteral("/secpar-service.sock");
+#endif
+}
+
+// One JSON object per line out, one line back. Runs on its own thread so a slow
+// or missing background part never stalls the stream.
+void runChannelCall(const QString& channel, const QByteArray& line,
+                    const std::shared_ptr<SecparMenu::ChannelCall>& call)
+{
+    QLocalSocket socket;
+
+    bool connected = false;
+    for (int attempt = 0; attempt < 5 && !connected; attempt++) {
+        socket.connectToServer(channel);
+        connected = socket.waitForConnected(300);
+        if (!connected) {
+            socket.abort();
+            std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        }
+    }
+
+    if (connected) {
+        socket.write(line);
+        if (socket.waitForBytesWritten(600)) {
+            QByteArray reply;
+            const qint64 deadline = QDateTime::currentMSecsSinceEpoch() + 2500;
+            while (!reply.contains('\n') && QDateTime::currentMSecsSinceEpoch() < deadline) {
+                if (!socket.waitForReadyRead(200)) {
+                    continue;
+                }
+                reply += socket.readAll();
+                if (reply.size() > 4096) {
+                    break;
+                }
+            }
+
+            const int end = reply.indexOf('\n');
+            const QByteArray text = end >= 0 ? reply.left(end) : reply;
+            const QJsonDocument document = QJsonDocument::fromJson(text);
+            if (document.isObject()) {
+                const QJsonObject answer = document.object();
+                call->answered = true;
+                call->ok = answer.value(QStringLiteral("ok")).toBool();
+                call->streaming = answer.value(QStringLiteral("streaming")).toBool();
+                call->connected = answer.value(QStringLiteral("connected_to_host")).toBool();
+                call->error = answer.value(QStringLiteral("error")).toString();
+            }
+        }
+    }
+
+    call->done.store(true, std::memory_order_release);
+}
