+}
+
+void SecparMenu::poll()
+{
+    if (m_Session == nullptr || m_Session->m_Window == nullptr) {
+        return;
+    }
+
+    m_Window = m_Session->m_Window;
+
+    // A resize or a fullscreen toggle changes where the picture is, so check
+    // before deciding there is nothing to do.
+    refreshGeometry();
+    pollChannel();
+    settlePendingSize();
+
+    // Re-send now and then even without a change, because a recreated renderer
+    // (fullscreen toggle, GPU reset) starts without our overlay texture.
+    const Uint32 period = m_Open ? 500 : 2000;
+    if (!m_Dirty && (SDL_GetTicks() - m_LastRendered) < period) {
+        return;
+    }
+
+    render();
+}
+
+void SecparMenu::refreshGeometry()
+{
+    int width = 0;
+    int height = 0;
+    SDL_GetWindowSize(m_Window, &width, &height);
+    if (width <= 0 || height <= 0) {
+        return;
+    }
+
+    int pixelWidth = width;
+#if SDL_VERSION_ATLEAST(2, 26, 0)
+    int pixelHeight = height;
+    SDL_GetWindowSizeInPixels(m_Window, &pixelWidth, &pixelHeight);
+#endif
+
+    double scale = static_cast<double>(pixelWidth) / width;
+    if (scale < 1.0) {
+        scale = 1.0;
+    }
+
+    if (width != m_WindowWidth || height != m_WindowHeight || !qFuzzyCompare(scale, m_Scale)) {
+        m_WindowWidth = width;
+        m_WindowHeight = height;
+        m_Scale = scale;
+        m_Dirty = true;
+    }
+}
+
+void SecparMenu::pushSurface(SDL_Surface* surface, const SDL_Rect& windowRect)
+{
+    m_Session->getOverlayManager().setOverlayImage(Overlay::OverlaySecparMenu, surface, windowRect);
+    m_LastRendered = SDL_GetTicks();
+    m_Dirty = false;
+}
+
+bool SecparMenu::matchesChord(const SDL_Keysym& keysym, const Chord& chord) const
+{
+    return chord.isValid() && keysym.sym == chord.key && chordMods(keysym.mod) == chord.mods;
+}
+
+int SecparMenu::rowAt(const QPoint& point) const
+{
+    for (int i = 0; i < m_RowRects.size() && i < m_RowActions.size(); i++) {
+        if (m_RowActions.at(i) != ActionNone && i < m_RowInteractive.size() &&
+            m_RowInteractive.at(i) && m_RowRects.at(i).contains(point)) {
+            return i;
+        }
+    }
+    return -1;
+}
