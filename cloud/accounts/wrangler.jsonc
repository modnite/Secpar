{
  "name": "secpar-accounts",
  "main": "src/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-11-04",
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://accounts.secpar.win",
    "EMAIL_FROM": "Secpar <accounts@mail.secpar.win>",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secpar-accounts",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // The relay service's own door for this service; see cloud/rendezvous.
  // Live updates for signed-in apps: one object per account holds its open WebSockets.
  "durable_objects": { "bindings": [{ "name": "EVENTS", "class_name": "Events" }] },
  "migrations": [{ "tag": "events-v1", "new_sqlite_classes": ["Events"] }],
  "services": [{ "binding": "RELAY", "service": "secpar-rendezvous", "entrypoint": "Turn" }],
  "keep_vars": true,
  "workers_dev": false,
  "routes": [
    {
      "pattern": "accounts.secpar.win",
      "custom_domain": true,
    },
  ],
}
